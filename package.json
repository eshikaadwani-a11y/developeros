{
  "name": "developeros",
  "version": "0.1.0",
  "description": "DeveloperOS - a developer command-center CLI",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "dev": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "node --test"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "productivity",
    "developeros"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
